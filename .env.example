# Copy to `.env` for local development, and set the same names as
# GitHub repo *Variables* (Settings > Secrets and variables > Actions > Variables)
# for the Pages build. These values are public by design (Firebase web config),
# but restrict the API key to your github.io domain in Google Cloud Console.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
